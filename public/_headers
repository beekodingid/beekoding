# ==============================================================================
# Cloudflare Pages Security & Cache Control Configuration
# Beekoding (beekoding.pages.dev / beekoding.id)
# ==============================================================================

# Global Security Headers across all routes
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-XSS-Protection: 1; mode=block
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# HTML Documents: Must revalidate to ensure instantaneous updates upon new deployment
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service Worker: Never cache aggressively so updates are detected immediately
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Web Manifest & Discovery Metadata
/manifest.webmanifest
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  Content-Type: application/manifest+json; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: text/plain; charset=utf-8
/ads.txt
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
/sitemap.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: application/xml; charset=utf-8

# Immutable long-term caching for hashed Vite static assets (JS, CSS, fonts)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Media & Image Assets
/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/*.webp
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/*.jpg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/*.jpeg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/*.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/*.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
